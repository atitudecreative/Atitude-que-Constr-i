# --- Obrigatórias ---
# Conexão PostgreSQL (>= 14). Em produção use um usuário sem privilégios de superusuário.
DATABASE_URL=postgresql://atitude:SENHA@localhost:5432/atitude_lp
# URL pública do site, sem barra final. Usada na verificação de origem (CSRF) das rotas de escrita.
APP_URL=http://localhost:3000
# Sal aleatório (>= 32 caracteres) para gerar hash de IP. Gere com: openssl rand -hex 32
IP_HASH_SALT=troque-por-um-valor-aleatorio-com-32-ou-mais-caracteres

# --- Rede ---
# "true" somente atrás de proxy reverso/CDN confiável que define X-Forwarded-For (Vercel, Cloudflare, Nginx).
TRUST_PROXY=false

# --- Opcional: aviso de novo cadastro por e-mail (SMTP) ---
# Formato: smtps://usuario:senha@smtp.exemplo.com:465
SMTP_URL=
MAIL_FROM="Atitude que Constrói <nao-responda@exemplo.com>"
LEAD_NOTIFY_TO=

# --- Opcional: envio de cadastros para a ferramenta do Inbound (CRM/automação) ---
# Cada cadastro é enviado por POST JSON assinado com HMAC-SHA256 no cabeçalho X-Signature.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
